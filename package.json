{
  "name": "lala-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "Plataforma open source que conecta doadores de equipamentos a Lalíderes da Latin American Leadership Academy.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/env.js && vite --open",
    "build": "node scripts/env.js && node scripts/build.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/test-db.sh",
    "test:functions": "cd supabase/functions && deno test --allow-env --allow-read _shared/ && deno check */index.ts",
    "seed:demo": "node scripts/seed-demo.js",
    "ai:prompts": "node scripts/build-prompts.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.14.0",
    "deno": "^2.9.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
