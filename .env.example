# Copie para `.env` e preencha. Nunca commite o arquivo `.env`.
# Sem SUPABASE_URL/SUPABASE_ANON_KEY o app roda no modo local (dados no navegador).

# --- Front-end (públicas: vão para js/env.js e para o navegador) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# true mostra dados e botões de demonstração; use false com pessoas reais
LALA_DEMO_MODE=true
# Senha das contas FICTÍCIAS de demonstração no Supabase (scripts/seed-demo.js)
LALA_DEMO_PASSWORD=

# --- Só no seu computador, para scripts/seed-demo.js (NUNCA na Vercel nem no front) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Segredos das Edge Functions (configure com `supabase secrets set`) ---
# WEBHOOK_SECRET=        segredo do Database Webhook da tabela offers (função notify)
# RESEND_API_KEY=        opcional: envio de e-mails
# NOTIFY_FROM=           ex.: LALA Bridge <avisos@seudominio.org>
# APP_URL=               ex.: https://lala-bridge.vercel.app
